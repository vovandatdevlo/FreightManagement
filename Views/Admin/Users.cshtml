@* ===== Views/Admin/Users.cshtml ===== *@
@model IEnumerable<FreightManagement.Models.Users>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý tài khoản";
}
<div class="page-header">
    <div>
        <h4><i class="bi bi-people me-2"></i>Quản lý tài khoản người dùng</h4>
        <small>Tổng: @Model.Count() tài khoản</small>
    </div>
</div>

<div class="mb-3">
    <a asp-controller="Admin"
       asp-action="AddStaff"
       class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Thêm nhân viên
    </a>
</div>

<div class="data-table">
    <table class="table">
        <thead><tr><th>ID</th><th>Họ tên</th><th>Email</th><th>SĐT</th><th>Địa chỉ</th><th>Vai trò</th><th>Ngày tạo</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td><small style="color:#999">#@u.UserId</small></td>
                    <td><strong>@u.HoTen</strong></td>
                    <td><small>@u.Email</small></td>
                    <td><small>@(u.SoDienThoai ?? "—")</small></td>
                    <td><small>@(u.DiaChi ?? "—")</small></td>
                    <td>
                        @{
                            var roleColor = u.Role?.RoleName switch
                            {
                                "Admin" => "#d32f2f",
                                "KhachHang" => "#1565c0",
                                "QuanLyKho" => "#e65100",
                                "TaiXe" => "#2e7d32",
                                _ => "#777"
                            };
                        }
                        <span style="background:@(roleColor)22;color:@roleColor;padding:3px 10px;border-radius:12px;font-size:.78rem;font-weight:600">@u.Role?.RoleName</span>
                    </td>
                    <td><small style="color:#999">@u.NgayTao.ToString("dd/MM/yyyy")</small></td>
                    <td>
                        <span style="background:@(u.TrangThai == "HoatDong" ? "#e8f5e9" : "#fce4ec");color:@(u.TrangThai == "HoatDong" ? "#2e7d32" : "#880e4f");padding:3px 10px;border-radius:12px;font-size:.78rem;font-weight:600">
                            @(u.TrangThai == "HoatDong" ? "Hoạt động" : "Bị khóa")
                        </span>
                    </td>
                    <td>
                        @if (u.RoleId != 1)
                        {
                            <a href="/Admin/ToggleUser/@u.UserId"
                               onclick="return confirm('Xác nhận @(u.TrangThai == "HoatDong" ? "khóa" : "mở khóa") tài khoản này?')"
                               class="btn btn-sm @(u.TrangThai == "HoatDong" ? "btn-outline-danger" : "btn-outline-success")">
                                <i class="bi @(u.TrangThai == "HoatDong" ? "bi-lock" : "bi-unlock")"></i>
                            </a>
                        }
                        @if (u.RoleId == 4)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary ms-1"
                                    onclick="openCCCDModal(@u.UserId, '@u.HoTen', '@u.CCCD')"
                                    title="Cập nhật CCCD">
                                <i class="bi bi-card-text"></i> CCCD
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal cập nhật CCCD tài xế -->
<div class="modal fade" id="cccdModal" tabindex="-1" aria-labelledby="cccdModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cccdModalLabel"><i class="bi bi-card-text me-2"></i>Cập nhật CCCD Tài xế</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Admin/UpdateDriverCCCD">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="driverId" id="modalDriverId" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tài xế</label>
                        <input type="text" id="modalDriverName" class="form-control" readonly style="background:#f5f5f5" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số CCCD <span class="text-danger">*</span></label>
                        <input type="text" name="cccd" id="modalCCCD" class="form-control"
                               placeholder="012345678901" maxlength="20" required />
                        <small class="text-muted">Nhập số CCCD/CMND của tài xế (phải là duy nhất)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>Lưu CCCD
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openCCCDModal(driverId, driverName, currentCCCD) {
        document.getElementById('modalDriverId').value = driverId;
        document.getElementById('modalDriverName').value = driverName;
        document.getElementById('modalCCCD').value = currentCCCD || '';
        var modal = new bootstrap.Modal(document.getElementById('cccdModal'));
        modal.show();
    }
</script>

@* ===== Views/Admin/AssignWarehouse.cshtml ===== *@
@model List<FreightManagement.Models.KhoHang>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Gán kho cho Quản lý kho";
    var qlks = ViewBag.QuanLyKhos as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div class="page-header">
    <div><h4><i class="bi bi-building-gear me-2"></i>Gán kho cho Quản lý kho</h4><small>Phân công kho cho từng quản lý kho</small></div>
    <a href="/Admin/Warehouses" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Danh sách kho</a>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#e8f5e9;border-left:4px solid #4caf50;padding:12px;margin-bottom:20px;border-radius:4px">
        <i class="bi bi-check-circle-fill" style="color:#4caf50;margin-right:8px"></i>
        <span style="color:#2e7d32">@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background:#ffebee;border-left:4px solid #f44336;padding:12px;margin-bottom:20px;border-radius:4px">
        <i class="bi bi-x-circle-fill" style="color:#f44336;margin-right:8px"></i>
        <span style="color:#d32f2f">@TempData["Error"]</span>
    </div>
}

<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>Tên kho</th>
                <th>Địa chỉ kho</th>
                <th>Sức chứa</th>
                <th>Quản lý kho hiện tại</th>
                <th>Gán quản lý</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center py-4" style="color:#aaa">Không có kho nào</td></tr>
            }
            @foreach (var k in Model)
            {
                <tr>
                    <td><strong style="color:#2e7d32">@k.TenKho</strong></td>
                    <td><small>@k.DiaChiKho</small></td>
                    <td>
                        <span style="font-size:.85rem;background:#f5f5f5;padding:4px 8px;border-radius:4px">
                            @k.SoLuongHienTai / @k.SucChua kiện
                        </span>
                    </td>
                    <td>
                        @if (k.QuanLyKho != null)
                        {
                            <div style="font-weight:600">@k.QuanLyKho.HoTen</div>
                            <small style="color:#999">@k.QuanLyKho.Email</small>
                        }
                        else
                        {
                            <span style="color:#f44336;font-weight:600">Chưa gán</span>
                        }
                    </td>
                    <td>
                        <form method="post" asp-action="AssignWarehouse" style="display:flex;gap:6px;align-items:center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maKho" value="@k.MaKho" />
                            <select name="maQLK" style="padding:6px;border:1px solid #ddd;border-radius:4px;font-size:.9rem;flex:1">
                                <option value="">-- Chọn quản lý --</option>
                                @if (qlks != null)
                                {
                                    @foreach (var q in qlks)
                                    {
                                        @if (q.UserId == k.MaQLK)
                                        {
                                            <option value="@q.UserId" selected>
                                                @q.HoTen (@q.Email)
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@q.UserId">
                                                @q.HoTen (@q.Email)
                                            </option>
                                        }
                                    }
                                }
                            </select>
                            <button type="submit" style="padding:6px 12px;background:#2e7d32;color:#fff;border:none;border-radius:4px;cursor:pointer;font-weight:600;font-size:.9rem;white-space:nowrap">
                                <i class="bi bi-check-lg me-1"></i>Gán
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div style="background:#f9f9f9;padding:15px;border-radius:8px;margin-top:20px;border-left:4px solid #2196f3">
    <p style="margin:0;color:#333;font-size:.95rem">
        <i class="bi bi-info-circle me-2" style="color:#2196f3"></i>
        <strong>Lưu ý:</strong> Mỗi kho chỉ có thể được gán cho 1 quản lý kho. 
        Quản lý kho sẽ chỉ nhìn thấy và quản lý những kho được gán cho mình.
    </p>
</div>

@* ===== Views/Driver/Delivering.cshtml ===== *@
@model IEnumerable<FreightManagement.Models.DonHang>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đang giao hàng";
}

<div class="page-header">
    <div><h4><i class="bi bi-truck me-2"></i>Đang giao hàng</h4><small>Xác nhận khi đã giao thành công đến tay người nhận</small></div>
</div>

@if (TempData["Success"] != null)
{
    <div style="background:#e8f5e9;border-left:4px solid #4caf50;padding:12px;margin-bottom:20px;border-radius:4px">
        <i class="bi bi-check-circle-fill" style="color:#4caf50;margin-right:8px"></i>
        <span style="color:#2e7d32">@TempData["Success"]</span>
    </div>
}

@if (TempData["Warning"] != null)
{
    <div style="background:#fff3e0;border-left:4px solid #ff9800;padding:12px;margin-bottom:20px;border-radius:4px">
        <i class="bi bi-exclamation-triangle-fill" style="color:#ff9800;margin-right:8px"></i>
        <span style="color:#e65100">@TempData["Warning"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="background:#ffebee;border-left:4px solid #f44336;padding:12px;margin-bottom:20px;border-radius:4px">
        <i class="bi bi-x-circle-fill" style="color:#f44336;margin-right:8px"></i>
        <span style="color:#d32f2f">@TempData["Error"]</span>
    </div>
}

<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Người nhận</th>
                <th>Địa chỉ nhận</th>
                <th>Hàng hóa</th>
                <th>Chi phí</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center py-4" style="color:#aaa">Không có đơn nào đang giao</td></tr>
            }
            @foreach (var d in Model)
            {
                <tr>
                    <td><strong style="color:#6a1b9a">#@d.MaDon.ToString("D5")</strong></td>
                    <td><div style="font-weight:600">@d.TenNguoiNhan</div><small style="color:#999">@d.SdtNguoiNhan</small></td>
                    <td><small>@d.DiaChiNhan</small></td>
                    <td><small>@(d.MoTaHang ?? "—")</small></td>
                    <td><strong>@d.ChiPhi.ToString("N0") ₫</strong></td>
                    <td>
                        <form method="post" style="display:flex;gap:6px;flex-wrap:wrap">
                            @Html.AntiForgeryToken()

                            @* Giao thành công *@
                            <button type="submit" formaction="/Driver/GiaoThanhCong" name="maDon" value="@d.MaDon" class="btn btn-success btn-sm" onclick="return confirm('Xác nhận đã giao hàng thành công?')">
                                <i class="bi bi-check-circle me-1"></i>Đã giao
                            </button>

                            @* YC4: Giao thất bại *@
                            <button type="button" class="btn btn-warning btn-sm"
                                    onclick="moModalThatBai(@d.MaDon)">
                                <i class="bi bi-exclamation-circle me-1"></i>Thất bại
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <!-- Modal nhập lý do thất bại -->
    <div id="modalThatBai" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center">
        <div style="background:#fff;border-radius:12px;padding:28px;width:420px;max-width:90%">
            <h6 style="margin-bottom:16px;font-weight:700"><i class="bi bi-exclamation-circle me-2" style="color:#e65100"></i>Xác nhận giao thất bại</h6>
            <label style="font-size:.9rem;margin-bottom:6px;display:block">Lý do thất bại <span class="text-danger">*</span></label>
            <textarea id="lyDoThatBai" class="form-control" rows="3" maxlength="255"
                      placeholder="VD: Không liên lạc được người nhận, sai địa chỉ..."></textarea>
            <div id="lyDoError" class="text-danger" style="font-size:.82rem;margin-top:4px;display:none">Vui lòng nhập lý do.</div>
            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="dongModal()">Hủy</button>
                <button type="button" class="btn btn-warning btn-sm" onclick="xacNhanThatBai()">Xác nhận thất bại</button>
            </div>
        </div>
    </div>

    <form id="formThatBai" method="post" action="/Driver/GiaoThatBai" style="display:none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="maDon" id="maDonThatBai" />
        <input type="hidden" name="lyDo" id="lyDoHidden" />
    </form>

    @section Scripts {
        <script>
            function moModalThatBai(maDon) {
                document.getElementById('maDonThatBai').value = maDon;
                document.getElementById('lyDoThatBai').value = '';
                document.getElementById('lyDoError').style.display = 'none';
                const modal = document.getElementById('modalThatBai');
                modal.style.display = 'flex';
            }
            function dongModal() {
                document.getElementById('modalThatBai').style.display = 'none';
            }
            function xacNhanThatBai() {
                const lyDo = document.getElementById('lyDoThatBai').value.trim();
                if (!lyDo) {
                    document.getElementById('lyDoError').style.display = 'block';
                    return;
                }
                document.getElementById('lyDoHidden').value = lyDo;
                document.getElementById('formThatBai').submit();
            }
        </script>
    }
</div>

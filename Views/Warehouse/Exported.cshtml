@* ===== Views/Warehouse/Exported.cshtml ===== *@
@model IEnumerable<FreightManagement.Models.HangTrongKho>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đơn xuất kho";
}

<div class="page-header">
    <div>
        <h4><i class="bi bi-box-arrow-up me-2"></i>Đơn đã xuất kho</h4>
        <small>Danh sách hàng đã được xuất từ các kho bạn quản lý</small>
    </div>
</div>

<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Kho</th>
                <th>Khách hàng</th>
                <th>Hàng hóa</th>
                <th>Tài xế</th>
                <th>Thời gian xuất kho</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center py-4" style="color:#aaa">Không có đơn nào đã xuất kho</td></tr>
            }
            @foreach (var h in Model)
            {
                <tr>
                    <td><strong style="color:#2e7d32">#@h.MaDon.ToString("D5")</strong></td>
                    <td><strong>@h.KhoHang?.TenKho</strong><br><small style="color:#999">@h.KhoHang?.DiaChiKho</small></td>
                    <td>
                        <strong>@h.DonHang?.KhachHang?.HoTen</strong><br>
                        <small style="color:#999">@h.DonHang?.KhachHang?.SoDienThoai</small>
                    </td>
                    <td><small>@(h.DonHang?.MoTaHang ?? "—") (@h.DonHang?.SoLuong kiện)</small></td>
                    <td><strong>@h.DonHang?.TaiXe?.HoTen</strong><br><small style="color:#999">@h.DonHang?.TaiXe?.SoDienThoai</small></td>
                    <td><small style="color:#999">@h.ThoiGianXuatKho?.ToString("dd/MM/yyyy HH:mm")</small></td>
                    <td><span class="badge-status badge-shipping">@h.DonHang?.TrangThai</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* ===== Views/Warehouse/Stock.cshtml ===== *@
@model IEnumerable<FreightManagement.Models.HangTrongKho>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Hàng trong kho";
}

<div class="page-header">
    <div>
        <h4><i class="bi bi-archive me-2"></i>Hàng đang trong kho</h4>
        <small>Danh sách hàng đang lưu trữ tại các kho bạn quản lý</small>
    </div>
</div>

<div class="data-table">
    <table class="table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Kho</th>
                <th>Khách hàng</th>
                <th>Hàng hóa</th>
                <th>Tài xế</th>
                <th>Thời gian vào kho</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center py-4" style="color:#aaa">Không có hàng nào trong kho của bạn</td></tr>
            }
            @foreach (var h in Model)
            {
                <tr>
                    <td><strong style="color:#2e7d32">#@h.MaDon.ToString("D5")</strong></td>
                    <td><strong>@h.KhoHang?.TenKho</strong><br><small style="color:#999">@h.KhoHang?.DiaChiKho</small></td>
                    <td>
                        <strong>@h.DonHang?.KhachHang?.HoTen</strong><br>
                        <small style="color:#999">@h.DonHang?.KhachHang?.SoDienThoai</small>
                    </td>
                    <td><small>@(h.DonHang?.MoTaHang ?? "—")</small></td>
                    <td>@(h.DonHang?.TaiXe?.HoTen ?? "Chưa gán")</td>
                    <td><small style="color:#999">@h.ThoiGianVaoKho.ToString("dd/MM/yyyy HH:mm")</small></td>
                    <td><span class="badge-status badge-warehouse">@h.DonHang?.TrangThai</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model IEnumerable<FreightManagement.Models.KhoHang>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Kho hàng tôi quản lý";
}

<div class="page-header">
    <div>
        <h4><i class="bi bi-building me-2"></i>Kho hàng tôi quản lý</h4>
        <small>Bạn đang phụ trách: @Model.Count() kho hàng</small>
    </div>
    <a href="/Warehouse/Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Dashboard tổng quan
    </a>
</div>

<div class="row g-3 mb-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>Hiện tại tài khoản của bạn chưa được gán quản lý kho hàng nào.
            </div>
        </div>
    }
    else
    {
        @foreach (var k in Model)
        {
            // Tính toán tỷ lệ sức chứa hàng hiện tại
            var pct = k.SucChua > 0 ? (int)((double)k.SoLuongHienTai / k.SucChua * 100) : 0;
            // Tự động đổi màu thanh tiến trình tùy thuộc vào độ đầy của kho
            var color = pct >= 80 ? "#d32f2f" : pct >= 50 ? "#e65100" : "#2e7d32";

            <div class="col-md-4">
                <div style="background:#fff; border-radius:14px; padding:22px; box-shadow:0 2px 8px rgba(0,0,0,.05); border-top:4px solid @color">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:14px">
                        <div>
                            <h6 style="font-weight:700; color:#222; margin:0">@k.TenKho</h6>
                            <small style="color:#999"><i class="bi bi-geo-alt me-1"></i>@k.DiaChiKho</small>
                        </div>
                        <span style="font-size:1.8rem">🏭</span>
                    </div>

                    <div style="margin-bottom:12px">
                        <div style="display:flex; justify-content:space-between; font-size:.82rem; margin-bottom:4px">
                            <span style="color:#666">Hiện tại / Sức chứa</span>
                            <span style="font-weight:700; color:@color">@k.SoLuongHienTai / @k.SucChua kiện (@pct%)</span>
                        </div>
                        <div style="background:#e8f5e9; border-radius:6px; height:8px">
                            <div style="background:@color; height:8px; border-radius:6px; width:@pct%; transition:width .5s"></div>
                        </div>
                    </div>

                    <div style="font-size:.82rem; color:#777; display:flex; justify-content:space-between; align-items:center; border-top: 1px solid #f1f8f1; padding-top: 10px;">
                        <span><i class="bi bi-person me-1"></i>Quản lý: <strong>@(k.QuanLyKho?.HoTen ?? "Chưa phân công")</strong></span>
                        <a href="/Warehouse/Stock?maKho=@k.MaKho" class="btn btn-link p-0 text-decoration-none" style="font-size:.82rem; color:var(--primary)">
                            Xem hàng <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>